VITE_FEATURE_CUSTOM_BRANDING=false
VITE_FEATURE_API_ACCESS=true
VITE_FEATURE_WEBHOOKS=false
VITE_FEATURE_SSO_ENABLED=false
VITE_FEATURE_2FA_ENABLED=false

