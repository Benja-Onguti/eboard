# ============================================
# EBOARD SOLUTIONS - ENVIRONMENT CONFIGURATION
# ============================================
# This file contains environment variables for local development
# Copy this file to .env.local for your local overrides
# Never commit sensitive values to version control!

# ============================================
# APPLICATION CONFIGURATION
# ============================================
VITE_APP_NAME=EBoard Solutions
VITE_APP_URL=http://localhost:3000
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0
VITE_APP_BUILD_DATE=2025-03-06
VITE_APP_DEFAULT_LOCALE=en-US
VITE_APP_SUPPORTED_LOCALES=en-US,es,fr,de

# ============================================
# API CONFIGURATION
# ============================================
VITE_API_URL=http://localhost:3001/api
VITE_API_VERSION=v1
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3
VITE_API_RETRY_DELAY=1000
VITE_API_KEY=dev_api_key_123456789

# ============================================
# AUTHENTICATION
# ============================================
VITE_AUTH_DOMAIN=localhost
VITE_AUTH_AUDIENCE=https://api.eboard-solutions.com
VITE_AUTH_CLIENT_ID=dev_client_id_123456
VITE_AUTH_REDIRECT_URI=http://localhost:3000/callback
VITE_AUTH_LOGOUT_URI=http://localhost:3000
VITE_AUTH_SCOPE="openid profile email offline_access"
VITE_AUTH_SESSION_TIMEOUT=3600
VITE_AUTH_REFRESH_TOKEN_ENABLED=true

# ============================================
# DATABASE (if using direct connection)
# ============================================
VITE_DATABASE_URL=postgresql://localhost:5432/eboard_dev
VITE_DATABASE_POOL_MIN=2
VITE_DATABASE_POOL_MAX=10

# ============================================
# FEATURE FLAGS
# ============================================
VITE_FEATURE_AI_MINUTES=true
