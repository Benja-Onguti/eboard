# ============================================
# FILE UPLOADS
# ============================================
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.jpg,.jpeg,.png,.txt
VITE_UPLOAD_CHUNK_SIZE=1048576
