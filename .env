# ============================================
# PERFORMANCE
# ============================================
VITE_CACHE_TTL=300
VITE_PAGE_SIZE=20
VITE_MAX_PAGE_SIZE=100
VITE_DEBOUNCE_DELAY=300
VITE_THROTTLE_DELAY=500
VITE_LAZY_LOAD_IMAGES=true
VITE_LAZY_LOAD_COMPONENTS=true
VITE_PREFETCH_LINKS=true
VITE_SERVICE_WORKER_ENABLED=false

# ============================================
# INTERNATIONALIZATION
# ============================================
VITE_I18N_DEBUG=false
VITE_I18N_FALLBACK_LOCALE=en-US
VITE_I18N_LOAD_PATHS=locales
VITE_DATE_FORMAT=MM/DD/YYYY
VITE_TIME_FORMAT=HH:mm:ss
VITE_TIMEZONE=America/New_York

